{
  "name": "rewind",
  "private": true,
  "type": "module",
  "workspaces": [
    "engine",
    "server",
    "web"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "server": "tsx server/index.ts",
    "web": "npm -w web run dev",
    "build": "npm -w web run build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "replay": "tsx server/replay.ts",
    "botmatch": "tsx scripts/botmatch.ts",
    "check:determinism": "node scripts/check-determinism.mjs"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
