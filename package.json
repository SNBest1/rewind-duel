{
  "name": "rewind",
  "private": true,
  "type": "module",
  "workspaces": [
    "engine",
    "server",
    "web",
    "clone",
    "rewind",
    "eval"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "server": "tsx server/index.ts",
    "web": "npm -w web run dev",
    "build": "npm -w web run build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "replay": "tsx server/replay.ts",
    "botmatch": "tsx scripts/botmatch.ts",
    "whatif": "tsx rewind/whatif-cli.ts",
    "eval": "tsx eval/run.ts",
    "export:unity": "tsx scripts/export-unity.ts",
    "check:determinism": "node scripts/check-determinism.mjs",
    "eval:live-clones": "tsx eval/clone-eval.ts",
    "eval:persona": "tsx eval/persona-eval.ts 6",
    "demo:data": "tsx scripts/demo-data.ts",
    "eval:belief": "tsx eval/belief-ablation.ts 4",
    "eval:ranks": "tsx eval/rank-ladder.ts 1",
    "eval:reads": "tsx eval/reads.ts 4"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
