# Port the match server listens on for both the built client and the WebSocket (default 8080).
# `npm run web` (Vite dev) assumes 8080; the built client uses the origin that served it.
PORT=8080
# Milliseconds per server tick (default 31.25 = 32 ticks/s). Only lower it to fast-forward bot matches in testing.
TICK_MS=31.25
