# Unity-generated, machine-local, or rebuildable — never commit these.
/Library/
/Temp/
/Obj/
/Build/
/Builds/
/Logs/
/UserSettings/
/.vscode/
*.csproj
*.sln
*.slnx
*.user
.DS_Store

# The exported replay data is generated by `npm run export:unity` from the Node engine.
# Keep it OUT of git: it is derived from data/<match>.json, which is the source of truth.
/Assets/StreamingAssets/map.json
/Assets/StreamingAssets/map.json.meta
/Assets/StreamingAssets/match.json
/Assets/StreamingAssets/match.json.meta
